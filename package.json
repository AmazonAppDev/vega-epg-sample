{
  "name": "epgsampleapp",
  "version": "0.0.2",
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf bundle build dist node_modules",
    "compile": "tsc -p tsconfig-build.json",
    "format": "npm-run-all lint:fix format:fix",
    "format:check": "prettier --check src tst",
    "format:fix": "prettier --write src tst",
    "lint": "eslint src tst --ext .ts,.tsx",
    "lint:fix": "eslint src tst --ext .ts,.tsx --fix",
    "start": "react-native start",
    "test": "jest --colors --passWithNoTests",
    "test:snapshot": "jest --colors --updateSnapshot",
    "build:release": "react-native build-kepler --build-type Release",
    "build:app": "npm-run-all build:release build:debug",
    "build:debug": "react-native build-kepler --build-type Debug",
    "release": "npm-run-all build:release build:debug",
    "prepublishOnly": "npm run release"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/keplerscript-epg": "^2.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "date-fns": "^4.0.0",
    "@amazon-devices/kepler-performance-api": "^0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^7.2.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.1.1",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "mustache": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "kepler": {
    "projectType": "application",
    "appName": "epgsampleapp",
    "targets": ["tv"],
    "features": ["vega"]
  }
}
